# ==============================================================================
# Sarvam AI & Model Configuration
# ==============================================================================
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=glm5.3
SARVAM_TEMPERATURE=0.2
SARVAM_MAX_TOKENS=2048
SARVAM_TIMEOUT_SECONDS=60.0

# ==============================================================================
# PostgreSQL & pgvector Database Configuration
# ==============================================================================
# For Docker Compose, the app container connects to postgres service on port 5432
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=rag_db

# Host port mapping for external DB inspection (e.g. pgAdmin/DBeaver)
POSTGRES_HOST_PORT=5433

# ==============================================================================
# Embeddings & Hybrid Retrieval Configuration
# ==============================================================================
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
TOP_K_RETRIEVAL=4
DENSE_WEIGHT=0.6
SPARSE_WEIGHT=0.4
RRF_K=60

# ==============================================================================
# Persistent Semantic Cache Configuration
# ==============================================================================
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_MAX_SIZE=5000

# ==============================================================================
# Application Server Port & Logging
# ==============================================================================
PORT=8000
LOG_LEVEL=INFO
